# PostgreSQL (used by docker-compose)
POSTGRES_PASSWORD=

# JWT
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Server
PORT=5001
NODE_ENV=production

# CORS - Allowed frontend origins (comma-separated)
ALLOWED_ORIGINS=https://isp-crm-frontend.vercel.app

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Resend (Email)
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# SAM (downstream Service Assurance Manager) webhook
# Local dev: SAM backend listens on :5500 (frontend on :3500).
# :5000 is THIS CRM's own backend — pointing the URL there would loop the
# request back to ourselves and 404 every activation. Set the same secret
# on the SAM side. If either is unset, the activation flow still works
# but no webhook fires.
SAM_WEBHOOK_URL=http://localhost:5500/integrations/crm/customer-activated
SAM_WEBHOOK_SECRET=
